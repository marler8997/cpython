# What the values in CPython's pyconfig.h mean, in the format described in conzig/README.md. The build
# passes this file and the one for its Python version to conzig, so nothing here depends on the
# version. The inputs are the target and libs.zlib, which says whether the build links zlib.
prelude define=_GNU_SOURCE define=_NETBSD_SOURCE define=__BSD_VISIBLE define=_DARWIN_C_SOURCE define=_POSIX_C_SOURCE=200809L define=_XOPEN_SOURCE=700 define=_XOPEN_SOURCE_EXTENDED define=_LARGEFILE_SOURCE define=_FILE_OFFSET_BITS=64

# Checks that need more than one line, or depend on each other
WORDS_BIGENDIAN ? 1|undef when target.cpu.endian == .big
DOUBLE_IS_BIG_ENDIAN_IEEE754 ? 1|undef when target.cpu.endian == .big
DOUBLE_IS_LITTLE_ENDIAN_IEEE754 ? 1|undef when target.cpu.endian == .little
