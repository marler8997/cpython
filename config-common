HAVE_STRUCT_STAT_ST_BLKSIZE ? 1|undef have-member "struct stat" st_blksize include=sys/stat.h
HAVE_GCC_ASM_FOR_X64 ? 1|undef links
    int main(void) {
        __asm__ __volatile__ ("movq %rcx, %rax");
    }
HAVE_GCC_UINT128_T ? 1|undef compiles
    int main(void) {
        __uint128_t x; x = (__uint128_t)1; (void)x;
    }
HAVE_GETHOSTBYNAME_R ? 1|undef have-function gethostbyname_r include=netdb.h
HAVE_GETHOSTBYNAME_R_6_ARG ? 1|undef compiles include=netdb.h if HAVE_GETHOSTBYNAME_R
    int main(void) {
        char *name; struct hostent *he, *res; char buffer[2048]; int buflen = 2048; int h_errnop;
        (void) gethostbyname_r(name, he, buffer, buflen, &res, &h_errnop);
    }
HAVE_GETHOSTBYNAME_R_5_ARG ? 1|undef compiles include=netdb.h if HAVE_GETHOSTBYNAME_R && !HAVE_GETHOSTBYNAME_R_6_ARG
    int main(void) {
        char *name; struct hostent *he; char buffer[2048]; int buflen = 2048; int h_errnop;
        (void) gethostbyname_r(name, he, buffer, buflen, &h_errnop);
    }
HAVE_GETHOSTBYNAME_R_3_ARG ? 1|undef compiles include=netdb.h if HAVE_GETHOSTBYNAME_R && !HAVE_GETHOSTBYNAME_R_6_ARG && !HAVE_GETHOSTBYNAME_R_5_ARG
    int main(void) {
        char *name; struct hostent *he; struct hostent_data data;
        (void) gethostbyname_r(name, he, &data);
    }
HAVE_DEV_PTMX ? 1|undef exists /dev/ptmx assume target.os.tag == .linux || target.os.tag == .macos
HAVE_DEV_PTC ? 1|undef exists /dev/ptc assume target.os.tag == .macos
HAVE_COMPUTED_GOTOS ? 1|undef runs assume true
    int main(int argc, char **argv) {
        static void *targets[1] = { &&LABEL1 };
        goto LABEL2;
    LABEL1:
        return 0;
    LABEL2:
        goto *targets[0];
        return 1;
    }
local sem_getvalue_works ? 1|undef runs include=unistd.h,fcntl.h,stdio.h,semaphore.h,sys/stat.h assume true
    int main(void) {
        sem_t *a = sem_open("/autocftw", O_CREAT, S_IRUSR|S_IWUSR, 0);
        int count;
        int res;
        if (a == SEM_FAILED) { perror("sem_open"); return 1; }
        res = sem_getvalue(a, &count);
        sem_close(a);
        sem_unlink("/autocftw");
        return res == -1 ? 1 : 0;
    }
HAVE_BROKEN_SEM_GETVALUE ? 1|undef when !sem_getvalue_works
PY_SUPPORT_TIER select
    1 if target.cpu.arch == .x86_64 && target.os.tag == .macos
    2 if target.cpu.arch == .aarch64 && target.os.tag == .macos
    2 if target.cpu.arch == .x86_64 && target.os.tag == .linux && target.abi.tag == .gnu
    2 if target.cpu.arch == .aarch64 && target.os.tag == .linux && target.abi.tag == .gnu
    3 if target.cpu.arch == .powerpc64le && target.os.tag == .linux && target.abi.tag == .gnu
    0

