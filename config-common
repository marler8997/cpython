ALIGNOF_SIZE_T alignof size_t include=stddef.h
SIZEOF_WCHAR_T sizeof wchar_t include=wchar.h
local wchar_t_signed ? 1|undef compiles include=wchar.h
    int main(void) {
        _Static_assert((wchar_t)-1 < 0, "unsigned");
    }
HAVE_USABLE_WCHAR_T ? 1|undef when SIZEOF_WCHAR_T >= 2 && !wchar_t_signed
HAVE_ALLOCA_H ? 1|undef have-header alloca.h
HAVE_CRYPT_H ? 1|undef have-header crypt.h
